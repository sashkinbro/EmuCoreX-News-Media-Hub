{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/metadata.schema.json",
  "title": "EmuCore Hub content metadata",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "contentVersion", "status", "publishedAt", "updatedAt", "categories", "tags", "canonicalUrl", "sources", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "enum": ["news", "videos", "history"] },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published"] },
    "publishedAt": { "$ref": "common.schema.json#/$defs/instant" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/instant" },
    "eventDate": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$" },
    "datePrecision": { "enum": ["year", "month", "day"] },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "relatedProductIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "canonicalUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source" } },
    "heroAssetId": { "$ref": "common.schema.json#/$defs/id" },
    "assets": { "type": "array", "maxItems": 5, "items": { "$ref": "asset.schema.json" } },
    "provider": { "const": "youtube" },
    "providerId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "channelTitle": { "type": "string", "minLength": 1 },
    "sourceLanguage": { "type": "string", "minLength": 2 },
    "featured": { "type": "boolean" },
    "priority": { "type": "integer" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "history" } } }, "then": { "required": ["eventDate", "datePrecision", "heroAssetId"], "properties": { "assets": { "minItems": 1 } } } },
    { "if": { "properties": { "type": { "const": "news" } } }, "then": { "required": ["heroAssetId"], "properties": { "assets": { "minItems": 1 } } } },
    { "if": { "properties": { "type": { "const": "videos" } } }, "then": { "required": ["provider", "providerId", "channelTitle", "sourceLanguage", "relatedProductIds"] } }
  ]
}
