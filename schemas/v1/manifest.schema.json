{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/manifest.schema.json",
  "title": "EmuCore Hub immutable catalog manifest",
  "type": "object",
  "required": ["formatVersion", "releaseId", "catalogRevision", "generatedAt", "defaultLocale", "supportedLocales", "localeFallbacks", "minimumClientVersionCode", "counts", "indexes", "assets", "tombstones"],
  "properties": {
    "formatVersion": { "const": 1 },
    "releaseId": { "$ref": "common.schema.json#/$defs/id" },
    "catalogRevision": { "type": "integer", "minimum": 1 },
    "generatedAt": { "$ref": "common.schema.json#/$defs/instant" },
    "defaultLocale": { "$ref": "common.schema.json#/$defs/locale" },
    "supportedLocales": { "type": "array", "minItems": 18, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/locale" } },
    "localeFallbacks": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/locale" } } },
    "minimumClientVersionCode": { "type": "integer", "minimum": 1 },
    "counts": { "type": "object", "required": ["news", "videos", "history"], "additionalProperties": { "type": "integer", "minimum": 0 } },
    "indexes": { "type": "object" },
    "assets": { "$ref": "common.schema.json#/$defs/fileReference" },
    "tombstones": { "$ref": "common.schema.json#/$defs/fileReference" }
  }
}
