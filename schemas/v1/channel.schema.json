{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/channel.schema.json",
  "title": "EmuCore Hub stable channel",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "channel", "releaseId", "catalogRevision", "issuedAt", "minimumClientVersionCode", "commit", "manifest"],
  "properties": {
    "formatVersion": { "const": 1 },
    "channel": { "const": "stable" },
    "releaseId": { "$ref": "common.schema.json#/$defs/id" },
    "catalogRevision": { "type": "integer", "minimum": 1 },
    "issuedAt": { "$ref": "common.schema.json#/$defs/instant" },
    "minimumClientVersionCode": { "type": "integer", "minimum": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifest": { "$ref": "common.schema.json#/$defs/fileReference" }
  }
}
