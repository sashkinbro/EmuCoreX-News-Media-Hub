{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/index.schema.json",
  "title": "EmuCore Hub localized index page",
  "type": "object",
  "required": ["formatVersion", "releaseId", "catalogRevision", "kind", "locale", "page", "items"],
  "properties": {
    "formatVersion": { "const": 1 },
    "releaseId": { "$ref": "common.schema.json#/$defs/id" },
    "catalogRevision": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["news", "videos", "history", "manuals"] },
    "locale": { "$ref": "common.schema.json#/$defs/locale" },
    "page": { "type": "integer", "minimum": 1 },
    "next": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/fileReference" }] },
    "items": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "title", "summary", "document", "sources"] } }
  }
}
