{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/asset.schema.json",
  "title": "EmuCore Hub image asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "variants", "rights"],
  "properties": {
    "assetId": { "$ref": "common.schema.json#/$defs/id" },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thumbnail", "display"],
      "properties": {
        "thumbnail": { "$ref": "#/$defs/sourceVariant" },
        "display": { "$ref": "#/$defs/sourceVariant" },
        "original": { "$ref": "#/$defs/sourceVariant" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "sourceUrl", "licenseId", "downloadAllowed"],
      "properties": {
        "creator": { "type": "string", "minLength": 1 },
        "sourceUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" },
        "licenseId": { "type": "string", "minLength": 1 },
        "licenseUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" },
        "attribution": { "type": "string" },
        "downloadAllowed": { "type": "boolean" },
        "modified": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sourceVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
