{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/article.schema.json",
  "title": "EmuCore Hub localized article",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "locale", "basedOnVersion", "localeVersion", "status", "title", "summary", "author", "searchKeywords", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "locale": { "$ref": "common.schema.json#/$defs/locale" },
    "basedOnVersion": { "type": "integer", "minimum": 1 },
    "localeVersion": { "type": "integer", "minimum": 1 },
    "status": { "const": "reviewed" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "heroAlt": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "searchKeywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "categoryLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "sourceLabels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["paragraph", "heading", "image", "gallery", "quote", "list", "callout", "link", "youtube"] },
          "text": { "type": "string" },
          "assetId": { "$ref": "common.schema.json#/$defs/id" },
          "assetIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "items": { "type": "array", "items": { "type": "string" } },
          "url": { "$ref": "common.schema.json#/$defs/httpsUrl" },
          "label": { "type": "string" },
          "providerId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    }
  }
}
