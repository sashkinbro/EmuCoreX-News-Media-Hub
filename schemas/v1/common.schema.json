{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sashkinbro/EmuCoreX-News-Media-Hub/main/schemas/v1/common.schema.json",
  "title": "EmuCore Hub common definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "locale": { "enum": ["ar", "cs", "de", "en", "es", "fa", "fr", "hi", "id", "it", "ja", "ko", "pl", "pt", "ru", "tr", "uk", "zh"] },
    "instant": { "type": "string", "format": "date-time" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "fileReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256", "bytes", "contentType"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "contentType": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "publishedAt": { "$ref": "#/$defs/instant" }
      }
    }
  }
}
